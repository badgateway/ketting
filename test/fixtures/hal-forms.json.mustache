{
    "_links" : {
        "self" : { "href" : "/{{tenantId}}/hal-forms.json" }
    },
    "_templates": {
      "create": {
        "method": "POST"
      },
      "createFailingWithStatus400": {
        "target": "/error/400",
        "method": "POST"
      },
      "update": {
        "method": "PUT"
      },
      "upload": {
        "target": "/echo",
        "method": "PUT",
        "contentType": "multipart/form-data",
        "properties": [
          { "name": "title", "type": "text", "required": true },
          { "name": "attachment", "type": "file", "required": true }
        ]
      }
    },
    "foo" : "bar"
}
